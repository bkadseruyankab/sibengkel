generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  password     String
  role         String   @default("ADMIN") // SUPER_ADMIN, ADMIN, BENGKEL, PIMPINAN
  phone        String?
  isActive     Boolean  @default(true)
  bengkelId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bengkel      Workshop?  @relation(fields: [bengkelId], references: [id])
  notifications Notification[] @relation("UserNotifications")
  auditLogs    AuditLog[]
  budgetHistories BudgetHistory[]
  signatures   Signature[]

  @@map("users")
}

model Vehicle {
  id               String   @id @default(cuid())
  nomorPolisi      String   @unique
  namaPengguna     String
  skpdBidang       String
  jenisKendaraan   String   // RODA_2, RODA_4
  merk             String
  type             String
  tahun            Int
  nomorRangka      String?
  nomorMesin       String?
  warna            String?
  statusKendaraan  String   @default("AKTIF") // AKTIF, NONAKTIF, RUSAK
  kondisiKendaraan String   @default("BAIK") // BAIK, KURANG_BAIK, RUSAK
  kilometerTerakhir Int     @default(0)
  fotoUrl          String?
  qrCodeHash      String?  @unique // Unique hash for QR code URL
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  documents    VehicleDocument[]
  services     Service[]
  budgets      Budget[]
  serviceHistory ServiceHistory[]

  @@map("vehicles")
}

model VehicleDocument {
  id           String   @id @default(cuid())
  vehicleId    String
  jenisDokumen String   // BPKB, STNK, FAKTUR, LAINNYA
  fileName     String
  filePath     String
  fileSize     Int?
  mimeType     String?  // MIME type for blob serving
  data         Bytes?   // Blob data stored in database
  uploadedAt   DateTime @default(now())

  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_documents")
}

model Service {
  id                    String    @id @default(cuid())
  nomorService          String    @unique
  documentNumber        String?   // Generated document number from penomoran surat (e.g., bkad/SRV/001/03/2026)
  tanggalService        DateTime
  vehicleId             String
  bengkelId             String
  jenisService          String    // RUTIN, PERBAIKAN, DARURAT
  keterangan            String?
  kilometerService      Int       @default(0)
  estimasiBiaya         Float     @default(0)
  totalBiaya            Float     @default(0)
  statusService         String    @default("DIAJUKAN") // DIAJUKAN, PENGAJUAN, DISETUJUI, DITOLAK, DIPROSES, MENUNGGU_PERSETUJUAN, PENDING, SELESAI
  prioritas             String    @default("NORMAL") // RENDAH, NORMAL, TINGGI, DARURAT
  estimasiLamaPerbaikan Int?      // dalam hari
  tanggalSelesai        DateTime?
  catatanAdmin          String?
  catatanBengkel        String?
  progress              Int       @default(0) // 0-100
  approvedBy            String?
  approvedAt            DateTime?
  rejectedReason        String?
  isDeleted             Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  vehicle      Vehicle        @relation(fields: [vehicleId], references: [id])
  bengkel      Workshop       @relation(fields: [bengkelId], references: [id])
  items        ServiceItem[]
  documents    ServiceDocument[]
  spareParts   ServiceSparePart[]
  history      ServiceHistory[]

  @@map("services")
}

model ServiceItem {
  id           String  @id @default(cuid())
  serviceId    String
  itemName     String
  quantity     Int     @default(1)
  hargaSatuan  Float   @default(0)
  totalHarga   Float   @default(0)
  keterangan   String?

  service      Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  photos       ServiceItemPhoto[]

  @@map("service_items")
}

model ServiceItemPhoto {
  id           String   @id @default(cuid())
  itemId       String
  fileName     String
  filePath     String
  fileSize     Int?
  fileType     String?
  mimeType     String?  // MIME type for blob serving
  data         Bytes?   // Blob data stored in database
  keterangan   String?
  uploadedAt   DateTime @default(now())

  item         ServiceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("service_item_photos")
}

model ServiceDocument {
  id            String   @id @default(cuid())
  serviceId     String
  fileName      String
  filePath      String
  fileSize      Int?
  fileType      String?   // MIME type
  mimeType      String?   // MIME type for blob serving
  data          Bytes?    // Blob data stored in database
  jenisDokumen  String    @default("NOTA") // NOTA, KWITANSI, FAKTUR, LAINNYA
  uploadedAt    DateTime @default(now())

  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_documents")
}

model Budget {
  id              String   @id @default(cuid())
  tahun           Int
  vehicleId       String
  jenisKendaraan  String   @default("RODA_4") // RODA_2, RODA_4
  totalAnggaran   Float   @default(0)
  realisasi       Float   @default(0)
  sisaAnggaran    Float   @default(0)
  statusAnggaran  String  @default("AKTIF") // AKTIF, NONAKTIF, HABIS
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id])
  history         BudgetHistory[]

  @@unique([tahun, vehicleId])
  @@map("budgets")
}

model BudgetHistory {
  id          String   @id @default(cuid())
  budgetId    String
  perubahan   Float
  keterangan  String?
  changedBy   String?
  createdAt   DateTime @default(now())

  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  changedByUser User?  @relation(fields: [changedBy], references: [id])

  @@map("budget_histories")
}

model Workshop {
  id              String   @id @default(cuid())
  namaBengkel     String
  alamat          String?
  noTelepon       String?
  picBengkel      String?
  email           String?
  statusAktif     Boolean  @default(true)
  canAddService   Boolean  @default(false) // Admin can toggle this to show/hide "Tambah Service" button for bengkel
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  services        Service[]
  users           User[]
  documents       WorkshopDocument[]
  spareParts      SparePart[]

  @@map("workshops")
}

model WorkshopDocument {
  id              String   @id @default(cuid())
  workshopId      String
  jenisDokumen    String   // KTP, NPWP, NIB, SPK, IZIN_USAHA, SURAT_KETERANGAN, LAINNYA
  fileName        String
  filePath        String
  fileSize        Int?
  fileType        String?  // MIME type
  mimeType        String?  // MIME type for blob serving
  data            Bytes?   // Blob data stored in database
  keterangan      String?
  uploadedBy      String?  // userId who uploaded
  uploadedAt      DateTime @default(now())

  workshop        Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@map("workshop_documents")
}

model SparePart {
  id             String   @id @default(cuid())
  namaSukuCadang String
  qty            Int      @default(0)
  hargaSatuan    Float    @default(0)
  supplier       String?
  stok           Int      @default(0)
  keterangan     String?
  isActive       Boolean  @default(true)
  bengkelId      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bengkel           Workshop          @relation(fields: [bengkelId], references: [id])
  serviceSpareParts ServiceSparePart[]

  @@map("spare_parts")
}

model ServiceSparePart {
  id           String    @id @default(cuid())
  serviceId    String
  sparePartId  String
  qty          Int       @default(1)
  hargaSatuan  Float     @default(0)
  totalHarga   Float     @default(0)

  service      Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  sparePart    SparePart @relation(fields: [sparePartId], references: [id])

  @@map("service_spare_parts")
}

model ServiceHistory {
  id          String   @id @default(cuid())
  serviceId   String
  vehicleId   String
  status      String
  keterangan  String?
  changedBy   String?
  createdAt   DateTime @default(now())

  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("service_histories")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO, WARNING, ERROR, SUCCESS
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model BlobFile {
  id        String   @id @default(cuid())
  key       String   @unique  // e.g., "app_logo", "app_favicon"
  fileName  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blob_files")
}

model Signature {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageData String   // Base64 encoded signature image (PNG)
  isActive  Boolean  @default(true) // Only one active signature per user
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("signatures")
}

model DocumentNumbering {
  id            String   @id @default(cuid())
  code          String   @unique    // e.g., "SRV", "LAP", "RWT", "SPP"
  name          String              // e.g., "Surat Service", "Laporan", "Riwayat Perbaikan"
  prefix        String   @default("bkad")
  currentNumber Int      @default(0) // Current sequential number for the year
  lastYear      Int      @default(0) // Year of last generated number (for yearly reset)
  digitCount    Int      @default(3) // Number of digits for zero-padding (3 = 001, 4 = 0001)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("document_numberings")
}
